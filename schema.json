{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "description",
    "channel",
    "published_at",
    "source_verified_at",
    "mandatory",
    "rules"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "channel": {
      "enum": [
        "baseline",
        "emergency",
        "regulatory"
      ]
    },
    "mandatory": {
      "type": "boolean"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "category",
          "severity",
          "target_languages",
          "message",
          "verification",
          "required",
          "source_urls",
          "check_steps",
          "excel_mapping"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "owasp_category": {
            "type": "string",
            "minLength": 1
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "target_languages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "typescript",
                "javascript",
                "json"
              ]
            }
          },
          "verification": {
            "const": "manual"
          },
          "required": {
            "const": true
          },
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^https://"
            }
          },
          "check_steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "excel_mapping": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "column",
              "action_required"
            ],
            "properties": {
              "column": {
                "type": "string",
                "minLength": 1
              },
              "action_required": {
                "const": "要対応"
              }
            }
          },
          "pattern_semantics": {
            "const": "review_candidate"
          },
          "detect": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "languages",
                  "sinks"
                ],
                "properties": {
                  "type": {
                    "const": "taint"
                  },
                  "languages": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "typescript",
                        "javascript",
                        "php",
                        "python",
                        "go",
                        "java",
                        "csharp",
                        "rust",
                        "cpp"
                      ]
                    }
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  },
                  "sanitizers": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  },
                  "builtin_sources": {
                    "type": "boolean"
                  },
                  "sinks": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "builtin"
                          ],
                          "properties": {
                            "builtin": {
                              "enum": [
                                "Command Injection",
                                "SQL Injection",
                                "Code Injection",
                                "Path Traversal",
                                "SSRF",
                                "XSS"
                              ]
                            }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "callee"
                          ],
                          "properties": {
                            "callee": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 300
                            },
                            "argument": {
                              "type": "integer",
                              "minimum": 0
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "languages"
                ],
                "properties": {
                  "type": {
                    "const": "object_access"
                  },
                  "languages": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "typescript",
                        "javascript",
                        "php"
                      ]
                    }
                  },
                  "owner_references": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  },
                  "authorization_calls": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  }
                }
              }
            ]
          }
        },
        "dependentRequired": {
          "pattern": [
            "pattern_semantics"
          ]
        }
      }
    },
    "published_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source_verified_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "advisory_published_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "channel": {
            "const": "emergency"
          }
        }
      },
      "then": {
        "required": [
          "advisory_published_at"
        ],
        "properties": {
          "mandatory": {
            "const": true
          }
        }
      }
    }
  ]
}
